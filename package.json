{
  "name": "nm-board",
  "version": "0.1.0",
  "description": "Live terminal board of firstmate's no-mistakes runs",
  "keywords": [
    "cli",
    "tui",
    "terminal",
    "agents",
    "firstmate",
    "no-mistakes",
    "ink"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "nm-watch": "dist/cli.js"
  },
  "files": [
    "dist",
    "herdr-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test --test-reporter=spec 'build-test/test/**/*.test.js'",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidrydberg/nm-watch.git"
  },
  "homepage": "https://github.com/davidrydberg/nm-watch#readme",
  "bugs": {
    "url": "https://github.com/davidrydberg/nm-watch/issues"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "chalk": "^6.0.1",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.3"
  }
}
